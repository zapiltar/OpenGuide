{
  // OpenGuide Bar Mode: admin site and the API that linked TVs pull from.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openguide-bar",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openguide-bar",
      // Replace with the id from `npx wrangler d1 create openguide-bar` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "openguide-bar-images" }],
  "vars": {
    // Your Cloudflare Access team domain, such as "mybars.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "",
    // The Application Audience (AUD) tag of the Access application protecting /admin and /api/admin.
    "ACCESS_AUD": "",
    // Comma-separated emails that can manage every bar.
    "OWNER_EMAILS": ""
  }
}
