{
  // OpenGuide Bar Mode: admin site and the API that linked TVs pull from.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openguide-bar",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // The admin site's own address. TVs use the workers.dev one, which must stay on.
  "routes": [
    { "pattern": "bar.exit7studios.com", "custom_domain": true },
    // Sends anyone who visits it to the newest app download.
    { "pattern": "apk.exit7studios.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Everything goes through the worker first, so apk.<domain> can send its visitors on to the app download
    // whatever they type after it; anything else falls through to these files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openguide-bar",
      // From `npx wrangler d1 create openguide-bar`. Local development ignores it.
      "database_id": "a29faf95-68d9-406d-b0b7-eb658f6b10e4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "openguide-bar-images" }],
  // Durable Objects, one of each per bar, SQLite-backed so they run on the free plan. A bingo room keeps the
  // bar's bingo game and a live connection to each TV showing it; a TV room keeps a live connection to each of
  // the bar's TVs that's on, to tell them when there are changes.
  "durable_objects": {
    "bindings": [
      { "name": "BINGO_ROOMS", "class_name": "BingoRoom" },
      { "name": "TV_ROOMS", "class_name": "TvRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BingoRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["TvRoom"] }
  ],
  // Secrets, set with `npx wrangler secret put SETUP_CODE`, not here:
  // SETUP_CODE: a long random code that creates the owner's account on /admin/#/setup, and resets its password.
  "vars": {}
}
