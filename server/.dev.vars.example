# Copy to .dev.vars for local development. Never put these on the deployed Worker, except SETUP_CODE as a secret.

# The code the setup page asks for when creating the owner account. On the deployed Worker, set it with
# `npx wrangler secret put SETUP_CODE` and make it long and random.
SETUP_CODE=local-setup-code

# Optional: skip signing in. Every admin request from localhost is treated as this email, and OWNER_EMAILS
# decides whether that's the owner. Only honoured on localhost. Leave these out to try the real sign-in.
# DEV_ADMIN_EMAIL=you@example.com
# OWNER_EMAILS=you@example.com
